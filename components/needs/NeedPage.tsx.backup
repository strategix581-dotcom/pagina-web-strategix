              <div className="need-intro-line">
                <span>STRATEGIX®</span>
                <span>01 — 03</span>
              </div>
            </div>

          </div>

          <div className="need-benefits">

            {data.benefits.map((benefit, index) => (
              <div className="need-benefit" key={benefit}>
                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>{benefit}</strong>

                <span className="need-benefit-arrow">↗</span>
              </div>
