            <div className="need-section-label">
              <span>01</span>
              <span>{labels.examples}</span>
            </div>

            <p>
              {isSpanish
                ? "Esto es lo que podemos crear para que tu negocio se vea, se recuerde y genere acción."
                : "This is the kind of work we can create to make your business seen, remembered and chosen."}
            </p>

          </div>


          <div className="need-work-grid">

            {visuals.map((item, index) => (

              <article
                className={`need-work-card ${
                  index === 0 ? "need-work-card-large" : ""
                }`}
                key={item.number}
              >

                <div className="need-work-image">

                  <div className="need-work-placeholder">

                    <span>{item.type}</span>

                    <small>
                      {isSpanish
                        ? "TU MATERIAL AQUÍ"
                        : "YOUR MATERIAL HERE"}
                    </small>

                  </div>

                  <div className="need-work-overlay">
                    <span>{item.number}</span>
                    <span>↗</span>
                  </div>

                </div>

                <div className="need-work-info">

                  <span>{item.type}</span>

                  <h3>{item.title}</h3>

                  <button type="button">
                    {labels.view}
                  </button>

                </div>

              </article>

            ))}

          </div>

        </div>

      </section>


      {/* APPROACH */}

      <section className="need-approach-section">

        <div className="need-page-container">

          <div className="need-section-label">
            <span>02</span>
            <span>{labels.approach}</span>
          </div>


          <div className="need-approach-grid">

            <div>
              <h2>{data.processTitle}</h2>
            </div>

            <div className="need-process-list">

              {data.processSteps.map((step, index) => (

                <div
                  className="need-process-row"
                  key={step}
                >

                  <span>
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <strong>{step}</strong>

                  <span>↗</span>

                </div>

              ))}

            </div>

          </div>

        </div>

      </section>


      {/* SERVICES */}

      <section className="need-services-section-new">

        <div className="need-page-container">

          <div className="need-section-label">
            <span>03</span>

            <span>
              {isSpanish
                ? "LO QUE PODEMOS HACER"
                : isPapiamento
                  ? "KIKO NOS POR HASI"
                  : "WHAT WE CAN DO"}
            </span>
          </div>

          <div className="need-services-list-new">

            {data.benefits.map((service, index) => (

              <div
                className="need-service-row-new"
                key={service}
              >

                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>{service}</strong>

                <span>↗</span>

              </div>

            ))}

          </div>

        </div>

      </section>


      {/* FINAL CTA */}

      <section className="need-final-cta">

        <div className="need-page-container">

          <span className="need-label">
            04 / {labels.cta}
          </span>

          <h2>{data.ctaTitle}</h2>

          <p>{data.ctaText}</p>

          <div className="need-cta-buttons">

            <a
              href={WHATSAPP}
              target="_blank"
              rel="noreferrer"
              className="need-cta-primary"
            >
              {data.ctaButton}
            </a>

            <a
              href={EMAIL}
              className="need-cta-secondary"
            >
              {isSpanish
                ? "ENVIAR EMAIL ↗"
                : isPapiamento
                  ? "MANDA EMAIL ↗"
                  : "SEND EMAIL ↗"}
            </a>

          </div>

        </div>

      </section>

    </main>
  )
}
  const { language } = useLanguage()

  const languageContent = content[language]
  const fallbackContent = content.EN

  const data = languageContent[slug] ?? fallbackContent[slug]

  if (!data) {
    return (
      <main className="need-page">
        <section className="need-page-hero">
          <div className="need-page-container">
            <p>Page not found.</p>
            <Link href="/">← Back home</Link>
          </div>
        </section>
      </main>
    )
  }

  return (
    <main className="need-page">
      {/* HERO */}
      <section className="need-page-hero">
        <div className="need-page-glow" />

        <div className="need-page-container">
          <div className="need-page-top">
            <Link href="/" className="need-back">
              ← {language === "ES" ? "Volver" : language === "PAP" ? "Bai bek" : "Back"}
            </Link>

            <span>{data.eyebrow}</span>
          </div>

          <div className="need-page-heading">
            <h1>{data.title}</h1>

            <div className="need-page-intro">
              <p>{data.intro}</p>
            </div>
          </div>

          {/* BENEFITS */}
          <div className="need-benefits">
            {data.benefits.map((benefit, index) => (
              <div className="need-benefit" key={benefit}>
                <span>0{index + 1}</span>
                <strong>{benefit}</strong>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* VISUAL PLACEHOLDER */}
      <section className="need-visual-section">
        <div className="need-page-container">
          <div className="need-section-label">
            <span>01</span>
            <span>{data.visualLabel}</span>
          </div>

          <div className="need-media-grid">
            <div className="need-media-card need-media-large">
              <div className="need-media-placeholder">
                <span>IMAGE / VIDEO</span>
                <small>MEDIA PLACEHOLDER</small>
              </div>
            </div>

            <div className="need-media-stack">
              <div className="need-media-card">
                <div className="need-media-placeholder">
                  <span>IMAGE</span>
                  <small>MEDIA PLACEHOLDER</small>
                </div>
              </div>

              <div className="need-media-card">
                <div className="need-media-placeholder">
                  <span>VIDEO / REEL</span>
                  <small>MEDIA PLACEHOLDER</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* PROCESS */}
      <section className="need-process-section">
        <div className="need-page-container">
          <div className="need-section-label">
            <span>02</span>
            <span>{data.processLabel}</span>
          </div>

          <div className="need-process-heading">
            <h2>{data.processTitle}</h2>
          </div>

          <div className="need-process-grid">
            {data.processSteps.map((step, index) => (
              <div className="need-process-card" key={step}>
                <span>0{index + 1}</span>
                <p>{step}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA */}
      <section className="need-cta-section">
        <div className="need-page-container">
          <div className="need-cta">
            <span className="need-cta-label">STRATEGIX®</span>

            <h2>{data.ctaTitle}</h2>

            <p>{data.ctaText}</p>

            <div className="need-cta-actions">
              <a
                href={WHATSAPP}
                target="_blank"
                rel="noreferrer"
                className="need-cta-primary"
              >
                {data.ctaButton}
              </a>

              <a href={EMAIL} className="need-cta-secondary">
                {language === "ES"
                  ? "ENVIAR EMAIL ↗"
                  : language === "PAP"
                    ? "MANDA EMAIL ↗"
                    : "SEND AN EMAIL ↗"}
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
  )
}
