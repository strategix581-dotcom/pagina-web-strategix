export default function NeedPage({ slug }: { slug: string }) {
  const { language } = useLanguage()

  const languageContent = content[language]
  const fallbackContent = content.EN
  const data = languageContent[slug] ?? fallbackContent[slug]

  if (!data) {
    return (
      <main className="need-page">
        <div className="need-page-container">
          <p>Page not found.</p>
          <Link href="/">← Back to Strategix</Link>
        </div>
      </main>
    )
  }

  const isSpanish = language === "ES"
  const isPapiamento = language === "PAP"

  const labels = {
    back: isSpanish
      ? "← Volver a Strategix"
      : isPapiamento
        ? "← Bai bek na Strategix"
        : "← Back to Strategix",

    examples: isSpanish
      ? "EJEMPLOS DE NUESTRO TRABAJO"
      : isPapiamento
        ? "EHÈMPLO DI NOS TRABOU"
        : "EXAMPLES OF OUR WORK",

    approach: isSpanish
      ? "CÓMO LO HACEMOS"
      : isPapiamento
        ? "KON NOS TA HASI"
        : "HOW WE DO IT",

    cta: isSpanish
      ? "HABLEMOS"
      : isPapiamento
        ? "LAGA NOS PAPIA"
        : "LET'S TALK",

    view: isSpanish
      ? "VER EJEMPLOS ↗"
      : isPapiamento
        ? "MIRA EHÈMPLO ↗"
        : "VIEW EXAMPLES ↗",
  }

  const visualContent = {
    "more-customers": [
      {
        number: "01",
        type: "CAMPAIGNS",
        title: isSpanish ? "Campañas que generan atención" : "Campaigns that get attention",
      },
      {
        number: "02",
        type: "CONTENT",
        title: isSpanish ? "Contenido que atrae clientes" : "Content that attracts customers",
      },
      {
        number: "03",
        type: "RESULTS",
        title: isSpanish ? "Marketing orientado a resultados" : "Results-driven marketing",
      },
    ],

    "better-content": [
      {
        number: "01",
        type: "PHOTOGRAPHY",
        title: isSpanish ? "Fotografía profesional" : "Professional photography",
      },
      {
        number: "02",
        type: "REELS",
        title: isSpanish ? "Reels que detienen el scroll" : "Reels that stop the scroll",
      },
      {
        number: "03",
        type: "VIDEO",
        title: isSpanish ? "Video comercial y cinematográfico" : "Commercial & cinematic video",
      },
    ],

    "social-media": [
      {
        number: "01",
        type: "CONTENT",
        title: isSpanish ? "Contenido para redes" : "Social media content",
      },
      {
        number: "02",
        type: "REELS",
        title: isSpanish ? "Reels y contenido vertical" : "Reels & vertical content",
      },
      {
        number: "03",
        type: "STRATEGY",
        title: isSpanish ? "Estrategia de contenido" : "Content strategy",
      },
    ],

    advertising: [
      {
        number: "01",
        type: "CAMPAIGNS",
        title: isSpanish ? "Campañas publicitarias" : "Advertising campaigns",
      },
      {
        number: "02",
        type: "CREATIVE",
        title: isSpanish ? "Creatividades para Meta Ads" : "Meta Ads creatives",
      },
      {
        number: "03",
        type: "PERFORMANCE",
        title: isSpanish ? "Campañas orientadas a resultados" : "Performance campaigns",
      },
    ],

    website: [
      {
        number: "01",
        type: "WEB DESIGN",
        title: isSpanish ? "Diseño web" : "Web design",
      },
      {
        number: "02",
        type: "MOBILE",
        title: isSpanish ? "Experiencias mobile-first" : "Mobile-first experiences",
      },
      {
        number: "03",
        type: "UX",
        title: isSpanish ? "Experiencias diseñadas para convertir" : "Experiences designed to convert",
      },
    ],

    "online-bookings": [
      {
        number: "01",
        type: "BOOKING",
        title: isSpanish ? "Sistemas de reservas" : "Booking systems",
      },
      {
        number: "02",
        type: "UX",
        title: isSpanish ? "Experiencias de reserva simples" : "Simple booking experiences",
      },
      {
        number: "03",
        type: "CONVERSION",
        title: isSpanish ? "Más oportunidades de conversión" : "More conversion opportunities",
      },
    ],
  }

  const visuals =
    visualContent[slug as keyof typeof visualContent] ??
    visualContent["more-customers"]

  return (
    <main className="need-page">

      {/* HERO */}

      <section className="need-page-hero">
        <div className="need-page-glow" />

        <div className="need-page-container">

          <div className="need-page-top">
            <Link href="/" className="need-back">
              {labels.back}
            </Link>

            <span>{data.eyebrow}</span>
          </div>

          <div className="need-page-heading">

            <div>
              <h1>{data.title}</h1>
            </div>

            <div className="need-page-intro">
